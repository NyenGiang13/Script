-- Lấy vị trí trung tâm Object/Model
local function getObjectPosition(obj)
    if obj:IsA("Model") then
        if obj.PrimaryPart then
            return obj.PrimaryPart.Position
        else
            local part = obj:FindFirstChildWhichIsA("BasePart")
            if part then return part.Position end
        end
    elseif obj:IsA("BasePart") then
        return obj.Position
    end
    return nil
end

-- Tạo Billboard ESP (Phân biệt Quái và Đồ Vật)
local function applyESP(object, guiName)
    if not object then return end
    local existingBillboard = object:FindFirstChild(guiName)
    
    if not existingBillboard then
        local billboard = Instance.new("BillboardGui")
        billboard.Name = guiName
        billboard.Size = UDim2.new(0, 200, 0, 50)
        billboard.StudsOffset = Vector3.new(0, 3.5, 0)
        billboard.AlwaysOnTop = true
        billboard.Adornee = object
        
        -- Phần tâm (Quái = Chấm tròn đỏ, Đồ vật = Hình vuông xanh dương)
        local coreMark = Instance.new("Frame")
        coreMark.Name = "CoreMark"
        coreMark.Size = UDim2.new(0, 9, 0, 9)
        coreMark.Position = UDim2.new(0.5, -4.5, 0.5, -4.5)
        coreMark.BorderSizePixel = 0
        coreMark.Parent = billboard
        
        local markCorner = Instance.new("UICorner")
        markCorner.Parent = coreMark
        
        if guiName == "MonsterDistGui" then
            coreMark.BackgroundColor3 = Color3.fromRGB(255, 50, 50) -- Đỏ cho quái
            markCorner.CornerRadius = UDim.new(1, 0) -- Tròn
        else
            coreMark.BackgroundColor3 = Color3.fromRGB(50, 150, 255) -- Xanh dương cho đồ vật
            markCorner.CornerRadius = UDim.new(0, 2) -- Vuông bo góc nhẹ
        end
        
        local markStroke = Instance.new("UIStroke")
        markStroke.Color = Color3.fromRGB(255, 255, 255)
        markStroke.Thickness = 1.5
        markStroke.Parent = coreMark

        -- Chữ tên + số mét
        local label = Instance.new("TextLabel")
        label.Name = "DistanceText"
        label.Size = UDim2.new(1, 0, 0, 25)
        label.Position = UDim2.new(0, 0, 0, -22)
        label.BackgroundTransparency = 1
        label.TextColor3 = guiName == "MonsterDistGui" and Color3.fromRGB(255, 255, 0) or Color3.fromRGB(100, 220, 255)
        label.Font = Enum.Font.GothamBold
        label.TextSize = 13
        label.TextStrokeTransparency = 0.1
        label.TextXAlignment = Enum.TextXAlignment.Center
        label.Text = object.Name .. " [0m]"
        label.Parent = billboard
        
        billboard.Parent = object
    end
end

