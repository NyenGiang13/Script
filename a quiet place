-- VÒNG LẶP CẬP NHẬT CHÍNH (RENDERSTEPPED)
---------------------------------------------------------
RunService.RenderStepped:Connect(function()
    local myChar = LocalPlayer.Character
    local myRoot = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Head"))
    if not myRoot then return end

    -- 1. XỬ LÝ CHO _Monsters
    local monstersFolder = Workspace:FindFirstChild("_Monsters")
    if monstersFolder then
        local currentMonsters = {}
        for _, monster in ipairs(monstersFolder:GetChildren()) do
            currentMonsters[monster] = true
            local pos = getObjectPosition(monster)
            local line = activeMonsterTracers[monster]
            local distGui = monster:FindFirstChild("MonsterDistGui")
            
            if pos then
                local dist = math.floor((myRoot.Position - pos).Magnitude)
                if distGui then
                    distGui.Enabled = true
                    if distGui:FindFirstChild("DistanceText") then
                        distGui.DistanceText.Text = string.format("%s [%dm]", monster.Name, dist)
                    end
                end
                
                if tracersEnabled then
                    if not line then
                        line = Instance.new("Frame")
                        line.BorderSizePixel = 0
                        line.AnchorPoint = Vector2.new(0.5, 0.5)
                        line.Parent = monsterTracersFolder
                        activeMonsterTracers[monster] = line
                    end
                    line.Visible = true
                    
                    local screenPos, _ = Camera:WorldToViewportPoint(pos)
                    local startPos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                    local targetPos = Vector2.new(screenPos.X, screenPos.Y)
                    
                    if screenPos.Z < 0 then
                        line.BackgroundColor3 = Color3.fromRGB(50, 255, 50) -- Xanh lá khi ở sau lưng
                        targetPos = Vector2.new(Camera.ViewportSize.X - screenPos.X, Camera.ViewportSize.Y - screenPos.Y)
                    else
                        line.BackgroundColor3 = Color3.fromRGB(255, 50, 50) -- Đỏ khi ở trước mặt
                    end
                    
                    local distanceVector = targetPos - startPos
                    line.Size = UDim2.new(0, distanceVector.Magnitude, 0, 2)
                    line.Position = UDim2.new(0, startPos.X + (distanceVector.X / 2), 0, startPos.Y + (distanceVector.Y / 2))
                    line.Rotation = math.deg(math.atan2(distanceVector.Y, distanceVector.X))
                end
            else
                if distGui then distGui.Enabled = false end
                if line then line.Visible = false end
            end
        end
        
        if tracersEnabled then
            for monster, line in pairs(activeMonsterTracers) do
                if not currentMonsters[monster] or not monster.Parent then
                    line:Destroy()
                    activeMonsterTracers[monster] = nil
                end
            end
        end
    end

    -- 2. XỬ LÝ CHO _Items
    local itemsFolder = Workspace:FindFirstChild("_Items")
    if itemsFolder then
        local currentItems = {}
        for _, item in ipairs(itemsFolder:GetChildren()) do
            currentItems[item] = true
            local pos = getObjectPosition(item)
            local line = activeItemTracers[item]
            local distGui = item:FindFirstChild("ItemDistGui")
            
            if pos then
                local dist = math.floor((myRoot.Position - pos).Magnitude)
                if distGui then
                    distGui.Enabled = true
                    if distGui:FindFirstChild("DistanceText") then
                        distGui.DistanceText.Text = string.format("%s [%dm]", item.Name, dist)
                    end
                end
                
                if itemTracersEnabled then
                    if not line then
                        line = Instance.new("Frame")
                        line.BorderSizePixel = 0
                        line.AnchorPoint = Vector2.new(0.5, 0.5)
                        line.Parent = itemTracersFolder
                        activeItemTracers[item] = line
                    end
                    line.Visible = true
                    
                    local screenPos, _ = Camera:WorldToViewportPoint(pos)
                    local startPos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                    local targetPos = Vector2.new(screenPos.X, screenPos.Y)
                    
                    if screenPos.Z < 0 then
                        line.BackgroundColor3 = Color3.fromRGB(50, 255, 50) -- Xanh lá khi ở sau lưng
                        targetPos = Vector2.new(Camera.ViewportSize.X - screenPos.X, Camera.ViewportSize.Y - screenPos.Y)
                    else
                        line.BackgroundColor3 = Color3.fromRGB(50, 150, 255) -- Xanh dương khi ở trước mặt
                    end
                    
                    local distanceVector = targetPos - startPos
                    line.Size = UDim2.new(0, distanceVector.Magnitude, 0, 2)
                    line.Position = UDim2.new(0, startPos.X + (distanceVector.X / 2), 0, startPos.Y + (distanceVector.Y / 2))
                    line.Rotation = math.deg(math.atan2(distanceVector.Y, distanceVector.X))
                end
            else
                if distGui then distGui.Enabled = false end
                if line then line.Visible = false end
            end
        end
        
        if itemTracersEnabled then
            for item, line in pairs(activeItemTracers) do
                if not currentItems[item] or not item.Parent then
                    line:Destroy()
                    activeItemTracers[item] = nil
                end
            end
        end
    end
end)

