-- LOGIC WALLHOP TỐI ƯU
---------------------------------------------------------
local toggle = false
local canJump = true
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function isNearWall()
    local char = game.Players.LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    rayParams.FilterDescendantsInstances = {char}
    local look = hrp.CFrame.LookVector
    local right = hrp.CFrame.RightVector
    local rays = {look, -look, right, -right}
    for _, dir in pairs(rays) do
        local res = workspace:Raycast(hrp.Position, dir * 3, rayParams)
        if res and res.Instance then return true end
    end
    return false
end

onBtn.MouseButton1Click:Connect(function()
    toggle = true
    status.Text = "Status: ACTIVE"
    status.TextColor3 = Color3.fromRGB(46, 204, 113)
end)

offBtn.MouseButton1Click:Connect(function()
    toggle = false
    status.Text = "Status: OFF"
    status.TextColor3 = Color3.fromRGB(255, 80, 80)
end)

destroyBtn.MouseButton1Click:Connect(function() screenGui:Destroy() end)

game:GetService("UserInputService").JumpRequest:Connect(function()
    if toggle and canJump and isNearWall() then
        canJump = false
        local char = game.Players.LocalPlayer.Character
        local hum = char:FindFirstChildOfClass("Humanoid")
        local root = char:FindFirstChild("HumanoidRootPart")
        local cam = workspace.CurrentCamera

        if hum and root then
            -- Ép trạng thái nhảy
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
            -- Thêm lực đẩy lên để hỗ trợ leo (Velocity)
            root.AssemblyLinearVelocity = Vector3.new(root.AssemblyLinearVelocity.X, 48, root.AssemblyLinearVelocity.Z)

            if mode == "Player" then
                root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(-45), 0)
                task.wait(0.03)
                root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(45), 0)
            else
                local oldCam = cam.CFrame
                cam.CFrame = cam.CFrame * CFrame.Angles(0, math.rad(-45), 0)
                task.wait(0.03)
                cam.CFrame = oldCam
            end
        end
        task.wait(0.05)
        canJump = true
    end
end)