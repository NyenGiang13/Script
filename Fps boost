--- LOGIC XU LY ---

local isEnabled = false
local originalMaterials = {}

-- Ham luu va thay doi do hoa
local function toggleLowPoly(state)
	if state then
		-- Luu lai thiet lap cu va bat Low Poly
		for _, v in pairs(workspace:GetDescendants()) do
			if v:IsA("BasePart") then
				originalMaterials[v] = {mat = v.Material, shadow = v.CastShadow}
				v.Material = Enum.Material.SmoothPlastic
				v.CastShadow = false
			end
		end
		settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
	else
		-- Tra lai thiet lap goc
		for part, data in pairs(originalMaterials) do
			if part and part.Parent then
				part.Material = data.mat
				part.CastShadow = data.shadow
			end
		end
		originalMaterials = {}
		settings().Rendering.QualityLevel = Enum.QualityLevel.Automatic
	end
end

-- Nut Activate/Deactivate
boostBtn.MouseButton1Click:Connect(function()
	isEnabled = not isEnabled
	if isEnabled then
		statusLabel.Text = "Status: ON"
		statusLabel.TextColor3 = Color3.fromRGB(80, 255, 80)
		boostBtn.Text = "DEACTIVATE"
		boostBtn.BackgroundColor3 = Color3.fromRGB(150, 50, 50)
		toggleLowPoly(true)
	else
		statusLabel.Text = "Status: OFF"
		statusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
		boostBtn.Text = "ACTIVATE"
		boostBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
		toggleLowPoly(false)
	end
end)

