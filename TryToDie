local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")

-- Cấu hình màu sắc
local COLOR_BG = Color3.fromRGB(30, 30, 30)
local COLOR_ACCENT = Color3.fromRGB(0, 170, 255)
local COLOR_ON = Color3.fromRGB(100, 255, 100)
local COLOR_OFF = Color3.fromRGB(255, 100, 100)

-- Hàm khởi tạo UI
local function create(className, properties)
	local instance = Instance.new(className)
	for p, v in pairs(properties) do instance[p] = v end
	return instance
end

-- Tính năng kéo thả
local function makeDraggable(guiObject, dragInputObject)
	local dragging, dragStart, startPos
	dragInputObject.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			dragStart = input.Position
			startPos = guiObject.Position
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
			local delta = input.Position - dragStart
			guiObject.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
	end)
end

-- Tạo ScreenGui
local ScreenGui = create("ScreenGui", {Name = "AutoGui", ResetOnSpawn = false, Parent = PlayerGui})

-- Nút hiện lại GUI
local ShowBtn = create("TextButton", {
	Name = "ShowButton", Size = UDim2.new(0, 45, 0, 45), Position = UDim2.new(0, 15, 0, 15),
	BackgroundColor3 = COLOR_BG, Text = "👁️", TextColor3 = Color3.new(1,1,1),
	Visible = false, Parent = ScreenGui
})
create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = ShowBtn})

-- Khung chính
local MainFrame = create("Frame", {
	Name = "MainFrame", Size = UDim2.new(0, 200, 0, 120), Position = UDim2.new(0.5, -100, 0.5, -60),
	BackgroundColor3 = COLOR_BG, Parent = ScreenGui
})
create("UICorner", {CornerRadius = UDim.new(0, 8), Parent = MainFrame})

local TitleBar = create("Frame", {Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = Color3.fromRGB(40, 40, 40), Parent = MainFrame})
create("UICorner", {CornerRadius = UDim.new(0, 8), Parent = TitleBar})
create("TextLabel", {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "AUTO TOOL", TextColor3 = COLOR_ACCENT, Font = Enum.Font.GothamBold, Parent = TitleBar})
makeDraggable(MainFrame, TitleBar)

local HideBtn = create("TextButton", {Size = UDim2.new(0, 30, 0, 30), Position = UDim2.new(1, -35, 0, 5), BackgroundTransparency = 1, Text = "×", TextColor3 = Color3.new(1,1,1), Parent = TitleBar})

-- Nút Auto Die
local DieBtn = create("TextButton", {
	Size = UDim2.new(0.8, 0, 0, 40), Position = UDim2.new(0.1, 0, 0.5, 0),
	BackgroundColor3 = Color3.fromRGB(50, 50, 50), Text = "Auto Die: OFF", TextColor3 = Color3.new(1,1,1),
	Parent = MainFrame
})
create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = DieBtn})

-- Logic
local autoDie = false

HideBtn.MouseButton1Click:Connect(function() MainFrame.Visible = false; ShowBtn.Visible = true end)
ShowBtn.MouseButton1Click:Connect(function() MainFrame.Visible = true; ShowBtn.Visible = false end)

DieBtn.MouseButton1Click:Connect(function()
	autoDie = not autoDie
	DieBtn.Text = autoDie and "Auto Die: ON" or "Auto Die: OFF"
	DieBtn.TextColor3 = autoDie and COLOR_ON or COLOR_OFF
end)

game:GetService("RunService").RenderStepped:Connect(function()
	if autoDie and Player.Character and Player.Character:FindFirstChild("Humanoid") then
		Player.Character.Humanoid.Health = 0
	end
end)
