-- Hàm tạo nút chức năng chuẩn
local function createToggleButton(name, defaultText)
	local btn = create("TextButton", {
		Name = name .. "Btn",
		Size = UDim2.new(1, 0, 0, 45),
		BackgroundColor3 = Color3.fromRGB(50, 50, 50),
		BorderSizePixel = 0,
		Text = defaultText .. ": OFF",
		TextColor3 = Color3.new(1, 1, 1),
		TextSize = 16,
		Font = Enum.Font.Gotham,
		Parent = ContentContainer,
	})
	create("UICorner", {CornerRadius = CORNER_RADIUS, Parent = btn})
	create("UIStroke", {Color = Color3.fromRGB(70, 70, 70), Thickness = 1, Parent = btn})
	
	-- Thêm hiệu ứng hover chuột
	btn.MouseEnter:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(65, 65, 65)}):Play()
	end)
	btn.MouseLeave:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(50, 50, 50)}):Play()
	end)
	
	return btn
end

