    local Button = Instance.new("TextButton")
    Button.Name = "DeltaBtn_" .. i
    Button.Size = UDim2.new(1, -6, 0, 38) -- Nới rộng 38px để chạm trên điện thoại dễ hơn
    Button.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    Button.Font = Enum.Font.Gotham
    Button.TextSize = 12
    Button.TextColor3 = Color3.fromRGB(225, 225, 225)
    Button.Text = "  " .. item.Name
    Button.TextXAlignment = Enum.TextXAlignment.Left
    Button.BorderSizePixel = 0
    Button.Parent = ScrollFrame
    
    local ButtonCorner = Instance.new("UICorner")
    ButtonCorner.CornerRadius = UDim.new(0, 6)
    ButtonCorner.Parent = Button
    
    -- Hiệu ứng Hover chạm/chuột
    Button.MouseEnter:Connect(function()
        Button.BackgroundColor3 = Color3.fromRGB(55, 55, 55)
    end)
    Button.MouseLeave:Connect(function()
        Button.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    end)
    
    -- Xử lý sao chép Link
    Button.MouseButton1Click:Connect(function()
        local linkStr = tostring(item.Link)
        
        -- Gọi hàm sao chép bộ nhớ tạm tương thích tốt nhất trên Delta
        if setclipboard then
            setclipboard(linkStr)
            
            -- Đổi màu hiệu ứng xanh lá thông báo thành công nhanh
            local currentText = Button.Text
            Button.Text = "  ✔ Đã copy link món " .. i
            Button.TextColor3 = Color3.fromRGB(120, 255, 120)
            Button.BackgroundColor3 = Color3.fromRGB(30, 75, 30)
            
            task.wait(0.5)
            Button.Text = currentText
            Button.TextColor3 = Color3.fromRGB(225, 225, 225)
            Button.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
        else
            -- Trường hợp khẩn cấp/Dự phòng lỗi
            print("Link món " .. i .. ": " .. linkStr)
            Button.Text = "  ❌ Delta lỗi hàm setclipboard"
            Button.TextColor3 = Color3.fromRGB(255, 100, 100)
            task.wait(1)
            Button.Text = "  " .. item.Name
            Button.TextColor3 = Color3.fromRGB(225, 225, 225)
        end
    end)
end

-- [[ LOGIC KÉO THẢ MƯỢT MÀ CHO CẢ CHUỘT VÀ CẢM ỨNG ]]
local dragging, dragInput, dragStart, startPos

local function update(input)
    local delta = input.Position - dragStart
    MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
end

TitleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

TitleBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        update(input)
    end
end)
